# Base URL of the Neara API. Never include a trailing slash.
# Production builds must use https:// — the app refuses to start with plain http outside development.
# The hosted API mounts all routes under /api, so its base URL ends in /api:
#   EXPO_PUBLIC_API_URL=https://neara-api.vercel.app/api
#
# Local development:
#   Android emulator: http://10.0.2.2:4000
#   iOS simulator:    http://localhost:4000
#   Physical device:  http://<your-lan-ip>:4000
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
