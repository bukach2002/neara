# Local monorepo convenience env.
# Prefer app-specific files for deployment:
# - apps/api/.env.example
# - apps/web/.env.example

# App URLs and environment
NODE_ENV=development
LOG_LEVEL=debug
WEB_APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_APP_URL=http://localhost:4000
NEXT_PUBLIC_API_APP_URL=http://localhost:4000
API_PORT=4000

# PostgreSQL 16+ with PostGIS
DATABASE_URL=postgresql://neara:neara@localhost:5432/neara?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Admin sessions and CSRF
SESSION_SECRET=replace-with-a-long-random-secret
CSRF_SECRET=replace-with-a-different-long-random-secret
SESSION_COOKIE_NAME=neara.sid
CUSTOMER_SESSION_COOKIE_NAME=neara.customer.sid
# Cookies are Secure and __Host- prefixed in production/staging.
# Set true only for local https testing.
COOKIE_SECURE_INSECURE_DEV=false

# Proxy topology: how many trusted proxies sit in front of the API.
# request.ip (used for rate limits) is derived from this, never from a client header.
TRUST_PROXY_HOPS=1

# Resend SMTP
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_API_KEY=
MAIL_FROM="Neara <no-reply@your-verified-domain.com>"

# SMS / WhatsApp OTP delivery. Use `twilio`, or leave `disabled` to keep the
# phone verification endpoints answering 503 instead of silently dropping codes.
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sends from an E.164 number for SMS, e.g. +12025550123
TWILIO_SMS_FROM=
# WhatsApp sender in Twilio's sandbox/production format, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Google Maps / Places / Geocoding
GOOGLE_MAPS_API_KEY=

# S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=neara-local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=http://localhost:9000/neara-local
UPLOAD_MAX_IMAGE_BYTES=5242880

# Shared rate limit store (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limits
RATE_LIMIT_PUBLIC_SEARCH_PER_MINUTE=100
RATE_LIMIT_PUBLIC_SLOT_LOOKUP_PER_MINUTE=120
RATE_LIMIT_PUBLIC_BOOKING_CREATE_PER_MINUTE=20
RATE_LIMIT_PUBLIC_BOOKING_LOOKUP_PER_MINUTE=30
RATE_LIMIT_ADMIN_LOGIN_PER_WINDOW=10
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
RATE_LIMIT_CUSTOMER_REGISTER_PER_MINUTE=10
RATE_LIMIT_CUSTOMER_LOGIN_PER_MINUTE=10
RATE_LIMIT_CUSTOMER_OTP_REQUEST_PER_HOUR=5
RATE_LIMIT_CUSTOMER_OTP_CONFIRM_PER_MINUTE=20
RATE_LIMIT_TENANT_SIGNUP_PER_HOUR=20
RATE_LIMIT_CLIENT_EVENTS_PER_MINUTE=60
RATE_LIMIT_MOBILE_AUTH_PER_MINUTE=20
RATE_LIMIT_MOBILE_REFRESH_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60
# Production and staging refuse to boot with the in-memory limiter unless this is set.
# Set ALLOW_IN_MEMORY_RATE_LIMIT=true only for single-instance deployments.
RATE_LIMIT_REQUIRE_SHARED_STORE=false
ALLOW_IN_MEMORY_RATE_LIMIT=false

# Sessions, lockout, MFA and verification
AUTH_ADMIN_SESSION_ABSOLUTE_HOURS=12
AUTH_ADMIN_SESSION_IDLE_MINUTES=30
AUTH_CUSTOMER_SESSION_ABSOLUTE_DAYS=7
AUTH_CUSTOMER_SESSION_IDLE_HOURS=24
AUTH_CUSTOMER_TRUSTED_ABSOLUTE_DAYS=30
AUTH_CUSTOMER_TRUSTED_IDLE_DAYS=7
AUTH_MAX_ACTIVE_SESSIONS=10
AUTH_LOCKOUT_THRESHOLD=10
AUTH_LOCKOUT_MINUTES=15
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_MAX_ACTIVE=3
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_STEP_UP_MINUTES=15
# Verification enforcement is opt-in so existing accounts keep working.
# Turn these on after running the verification flows in production.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_REQUIRE_PHONE_VERIFICATION=false
AUTH_REQUIRE_PLATFORM_MFA=false
